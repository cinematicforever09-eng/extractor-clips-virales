# Todo corre en tu equipo. No hay claves de API ni servicios en la nube.
# Este archivo solo sirve para cambiar rutas o modelos si los tienes en otro sitio.

# Ruta a whisper.cpp si no está en bin/whisper
# WHISPER_PATH=C:\ruta\a\whisper-cli.exe
# WHISPER_MODEL=C:\ruta\a\ggml-large-v3-turbo.bin

# Ollama, si lo tienes en otro host o quieres forzar un modelo
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Rutas a los binarios si no están en bin/ ni en el PATH
# FFMPEG_PATH=C:\ruta\a\ffmpeg.exe
# YTDLP_PATH=C:\ruta\a\yt-dlp.exe

# Puerto del servidor
# PORT=3000
